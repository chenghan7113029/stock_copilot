# 外部参考 clone（整个 ref 目录不纳入本仓库）
ref/

# 分析报告产出
reports/*
!reports/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
env/

# 环境变量与密钥
.env
.env.*
*.env.local

# 测试与缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Node（OpenSpec CLI 为全局安装，此处忽略本地 node_modules）
node_modules/

# OS / IDE
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/

# 日志目录（保留目录结构，忽略日志文件）
log/*
!log/.gitkeep

# 配置（保留 example，忽略本地覆盖）
config/app.yaml
config/*.local.yaml
