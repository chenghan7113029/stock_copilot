# 外部参考 clone（整个 ref 目录不纳入本仓库）
ref/

# 分析报告产出
reports/*
!reports/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
env/

# 环境变量与密钥
.env
.env.*
*.env.local

# 测试与缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Node（OpenSpec CLI 为全局安装，此处忽略本地 node_modules）
node_modules/

# OS / IDE
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/

# 日志目录（保留目录结构，忽略日志文件）
log/*
!log/.gitkeep

# 配置（保留 example，忽略本地覆盖）
config/app.yaml
config/*.local.yaml

# 本地 SQLite（保留 fixtures seed 供 Cloud Agent）
data/*
!data/.gitkeep
!data/fixtures/
!data/fixtures/**

# 第三方 skill 包（体积大，由 skills-lock.json + 安装器复现，不进仓库）
# 只跟踪 openspec-* 与本项目自有的 skill
.agents/skills/lark-*/

# 工具接入：本项目只跟踪 .cursor 与 .dsh 的 openspec 接入
.claude/
.codex/

# 临时目录与测试残留（pytest / 调试脚本会重新生成）
/tmp*/
/.tmp/
/pytestbasetemp/
/.pytest-tmp/

# AgentTeams 运行时状态（含 mailbox / attempt，属运行态不属源码）
.agent-teams/

# 沙箱 ACL 诊断脚本的一次性报告（排查工具产物，不入库）
.acl-recovery/
